<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Description>Pokémon C# Class Library</Description>
    <RootNamespace>PKHeX.Core</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackage>true</IsPackage>
    <PackageId>PKHeX.Core</PackageId>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/kwsch/PKHeX</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kwsch/PKHeX</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\**" />
    <EmbeddedResource Include="Resources\**" />
    <!-- Exclude old duplicate files to avoid compilation conflicts -->
    <Compile Remove="Legality\Areas\**" />
    <Compile Remove="Legality\Assets\**" />
    <Compile Remove="Items\**" />
    <!-- Exclude consolidated generation directories that contain duplicates -->
    <Compile Remove="Legality\Encounters\Data\Gen45\**" />
    <Compile Remove="Legality\Encounters\Data\Gen67\**" />
    <Compile Remove="Legality\Encounters\Data\Gen12\**" />
    <!-- Exclude old EncounterSlot directory -->
    <Compile Remove="Legality\Encounters\EncounterSlot\**" />
    <!-- Exclude specific duplicate files in root Data directory -->
    <Compile Remove="Legality\Encounters\Data\Encounters9.cs" />
    <!-- Exclude old encounter structure directories that have duplicates in Templates -->
    <Compile Remove="Legality\Encounters\EncounterStatic\**" />
    <Compile Remove="Legality\Encounters\EncounterTrade\**" />
    <Compile Remove="Legality\Encounters\EncounterMisc\**" />
    <!-- Exclude duplicate interface files at root level -->
    <Compile Remove="Legality\Encounters\IEncounterable.cs" />
    <Compile Remove="Legality\Encounters\IEncounterMatch.cs" />
    <Compile Remove="Legality\Encounters\IEncounterTemplate.cs" />
    <Compile Remove="Legality\Encounters\IEncounterConvertible.cs" />
    <Compile Remove="Legality\Encounters\IEncounterInfo.cs" />
    <Compile Remove="Legality\Encounters\IEncounterFormRandom.cs" />
    <Compile Remove="Legality\Encounters\EncounterMatchRating.cs" />
    <!-- Exclude old structure files that duplicate Templates/Interfaces/Properties -->
    <Compile Remove="Legality\Structures\ILocation.cs" />
    <Compile Remove="Legality\Structures\IFixedAbilityNumber.cs" />
    <Compile Remove="Legality\Structures\IFixedBall.cs" />
    <Compile Remove="Legality\Structures\IMoveset.cs" />
    <Compile Remove="Legality\Structures\IRelearn.cs" />
    <Compile Remove="Legality\Structures\IShinyPotential.cs" />
    <Compile Remove="Legality\Structures\IndividualValueSet.cs" />
    <Compile Remove="Legality\Structures\Moveset.cs" />
  </ItemGroup>

</Project>
