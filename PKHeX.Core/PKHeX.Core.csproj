<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Description>Pokémon C# Class Library</Description>
    <RootNamespace>PKHeX.Core</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackage>true</IsPackage>
    <PackageId>PKHeX.Core</PackageId>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/kwsch/PKHeX</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kwsch/PKHeX</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\**" />
    <EmbeddedResource Include="Resources\**" />
    <!-- Exclude old duplicate files to avoid compilation conflicts -->
    <Compile Remove="Legality\Areas\**" />
    <Compile Remove="Legality\Assets\**" />
    <!-- Exclude consolidated generation directories that contain duplicates -->
    <Compile Remove="Legality\Encounters\Data\Gen45\**" />
    <Compile Remove="Legality\Encounters\Data\Gen67\**" />
    <Compile Remove="Legality\Encounters\Data\Gen12\**" />
    <!-- Exclude old EncounterSlot directory -->
    <Compile Remove="Legality\Encounters\EncounterSlot\**" />
    <!-- Exclude specific duplicate files in root Data directory -->
    <Compile Remove="Legality\Encounters\Data\Encounters9.cs" />
    <!-- Exclude old encounter structure directories that have duplicates in Templates -->
    <Compile Remove="Legality\Encounters\EncounterStatic\**" />
    <Compile Remove="Legality\Encounters\EncounterTrade\**" />
    <Compile Remove="Legality\Encounters\EncounterMisc\**" />
    <!-- Exclude duplicate interface files at root level -->
    <Compile Remove="Legality\Encounters\IEncounterable.cs" />
    <Compile Remove="Legality\Encounters\IEncounterMatch.cs" />
    <Compile Remove="Legality\Encounters\IEncounterTemplate.cs" />
    <Compile Remove="Legality\Encounters\IEncounterConvertible.cs" />
    <Compile Remove="Legality\Encounters\IEncounterInfo.cs" />
    <Compile Remove="Legality\Encounters\IEncounterFormRandom.cs" />
    <Compile Remove="Legality\Encounters\EncounterMatchRating.cs" />
    <!-- Exclude old structure files that duplicate Templates/Interfaces/Properties -->
    <Compile Remove="Legality\Structures\ILocation.cs" />
    <Compile Remove="Legality\Structures\IFixedAbilityNumber.cs" />
    <Compile Remove="Legality\Structures\IFixedBall.cs" />
    <Compile Remove="Legality\Structures\IMoveset.cs" />
    <Compile Remove="Legality\Structures\IRelearn.cs" />
    <Compile Remove="Legality\Structures\IShinyPotential.cs" />
    <Compile Remove="Legality\Structures\IndividualValueSet.cs" />
    <Compile Remove="Legality\Structures\Moveset.cs" />
    <!-- Exclude duplicate save files in root directory - correct ones are in subdirectories -->
    <Compile Remove="Saves\SAV3GCMemoryCard.cs" />
    <!-- Exclude individual Tables files that duplicate constants in Legal.cs -->
    <Compile Remove="Legality\Tables\Tables1.cs" />
    <Compile Remove="Legality\Tables\Tables2.cs" />
    <Compile Remove="Legality\Tables\Tables3.cs" />
    <Compile Remove="Legality\Tables\Tables4.cs" />
    <Compile Remove="Legality\Tables\Tables5.cs" />
    <Compile Remove="Legality\Tables\Tables6.cs" />
    <Compile Remove="Legality\Tables\Tables7.cs" />
    <Compile Remove="Legality\Tables\Tables7b.cs" />
    <Compile Remove="Legality\Tables\Tables8.cs" />
    <Compile Remove="Legality\Tables\Tables8a.cs" />
    <Compile Remove="Legality\Tables\Tables8bs.cs" />
    <Compile Remove="Legality\Tables\Tables9.cs" />
    <!-- Exclude old duplicate files in root Substructures directories -->
    <Compile Remove="Saves\Substructures\PokeDex\Zukan9.cs" />
    <Compile Remove="Saves\Substructures\Gen5\CGearBackground.cs" />
    <!-- Exclude duplicate rental team files - correct ones in Rentals subdirectory -->
    <Compile Remove="Saves\Substructures\Gen9\RentalTeam9.cs" />
    <Compile Remove="Saves\Substructures\Gen9\RentalTeamSet9.cs" />
    <!-- Exclude old files that have been reorganized to better locations -->
    <Compile Remove="Legality\Verifiers\ParseSettings.cs" />
    <Compile Remove="Legality\Structures\ITrainerInfo.cs" />
    <Compile Remove="Legality\Structures\SimpleTrainerInfo.cs" />
    <Compile Remove="Legality\Verifiers\Ribbons\RibbonIndex3.cs" />
    <Compile Remove="Legality\Verifiers\Ribbons\RibbonIndex4.cs" />
    <!-- Exclude duplicate files moved to Templates organization -->
    <Compile Remove="Legality\Enums\EncounterTime.cs" />
    <Compile Remove="Legality\Enums\GroundTileAllowed.cs" />
    <Compile Remove="Legality\Structures\Shiny.cs" />
    <Compile Remove="Legality\Encounters\Generator\AbilityPermission.cs" />
    <Compile Remove="Legality\Structures\IMasteryInitialMoveShop8.cs" />
    <!-- Exclude duplicate RNG and interface files -->
    <Compile Remove="Legality\RNG\Locks\SeedFrame.cs" />
    <Compile Remove="Legality\RNG\Locks\TeamLockResult.cs" />
    <Compile Remove="Saves\Substructures\Misc\IRentalTeam.cs" />
    <!-- Exclude more rental team duplicates -->
    <Compile Remove="Saves\Substructures\Gen8\SWSH\RentalTeam8.cs" />
    <!-- Exclude more RNG and utility duplicates -->
    <Compile Remove="Saves\Substructures\Gen8\LA\Epoch1970Value.cs" />
    <Compile Remove="Legality\RNG\Methods\ToxtricityUtil.cs" />
    <Compile Remove="Legality\RNG\Methods\Tera9RNG.cs" />
